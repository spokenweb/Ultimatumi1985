:"TextualBody","value":"Recording","format":"text/plain","purpose":"tagging","motivation":"tagging"}],"target":"https://spokenweb.github.io/Ultimatumi1985/ken_decker_at_ultimatum_festival_1985_05_02/canvas/9#t=957,959"},{"@context":"http://www.w3.org/ns/anno.jsonld","type":"Annotation","motivation":["commenting","tagging"],"id":"https://spokenweb.github.io/Ultimatumi1985/ken_decker_at_ultimatum_festival_1985_05_02/canvas/9/page1","body":[{"type":"TextualBody","value":"[End of recording].","format":"text/plain","motivation":"commenting"},{"type":"TextualBody","value":"END","format":"text/plain","purpose":"tagging","motivation":"tagging"}],"target":"https://spokenweb.github.io/Ultimatumi1985/ken_decker_at_ultimatum_festival_1985_05_02/canvas/9#t=959,959"},{"@context":"http://www.w3.org/ns/anno.jsonld","type":"Annotation","motivation":["commenting","tagging"],"id":"https://spokenweb.github.io/Ultimatumi1985/ken_decker_at_ultimatum_festival_1985_05_02/canvas/9/page1","body":[{"type":"TextualBody","value":"Coughing.","format":"text/plain","motivation":"commenting"},{"type":"TextualBody","value":"Audience","format":"text/plain","purpose":"tagging","motivation":"tagging"}],"target":"https://spokenweb.github.io/Ultimatumi1985/ken_decker_at_ultimatum_festival_1985_05_02/canvas/9#t=702,707"},{"@context":"http://www.w3.org/ns/anno.jsonld","type":"Annotation","motivation":["commenting","tagging"],"id":"https://spokenweb.github.io/Ultimatumi1985/ken_decker_at_ultimatum_festival_1985_05_02/canvas/9/page1","body":[{"type":"TextualBody","value":"Room noise.","format":"text/plain","motivation":"commenting"},{"type":"TextualBody","value":"Foufounes Electriques","format":"text/plain","purpose":"tagging","motivation":"tagging"}],"target":"https://spokenweb.github.io/Ultimatumi1985/ken_decker_at_ultimatum_festival_1985_05_02/canvas/9#t=247,248"}]},{"@context":"http://iiif.io/api/presentation/3/context.json","id":"https://spokenweb.github.io/Ultimatumi1985/manifests/ken_decker_at_ultimatum_festival_1985_05_02-canvas9-1","type":"AnnotationPage","label":{"en":["Alan Lord Commentary"]},"items":[{"@context":"http://www.w3.org/ns/anno.jsonld","type":"Annotation","motivation":["commenting","tagging"],"id":"https://spokenweb.github.io/Ultimatumi1985/ken_decker_at_ultimatum_festival_1985_05_02/canvas/9/page1","body":[{"type":"TextualBody","value":"Montreal writer Ken Decker conversed with his Apple II computer. To my knowledge, this performance of a writer interacting live with a computer was a first.","format":"text/plain","motivation":"commenting"},{"type":"TextualBody","value":"Event Description","format":"text/plain","purpose":"tagging","motivation":"tagging"},{"type":"TextualBody","value":"Personal Anecdote","format":"text/plain","purpose":"tagging","motivation":"tagging"}],"target":"https://spokenweb.github.io/Ultimatumi1985/ken_decker_at_ultimatum_festival_1985_05_02/canvas/9#t=0,0"},{"@context":"http://www.w3.org/ns/anno.jsonld","type":"Annotation","motivation":["commenting","tagging"],"id":"https://spokenweb.github.io/Ultimatumi1985/ken_decker_at_ultimatum_festival_1985_05_02/canvas/9/page1","body":[{"type":"TextualBody","value":"Ken Decker explains: “At the time, I was writing some software for Logo Computer Systems Inc. They gave me a by-then obsolete Apple II Plus, along with a compact Apple IIc and that little monitor and very expensive external disc drive. The piece I performed at was called “STOP 4 GAS” and was written in FP-BASIC, which language was included in on-board ROM. I used a chain of video splitters and RF cable to send the monitor image out to the TV sets in the Foufoune Électrique’s bar.”","format":"text/plain","motivation":"commenting"},{"type":"TextualBody","value":"Event Description","format":"text/plain","purpose":"tagging","motivation":"tagging"}],"target":"https://spokenweb.github.io/Ultimatumi1985/ken_decker_at_ultimatum_festival_1985_05_02/canvas/9#t=45,45"},{"@context":"http://www.w3.org/ns/anno.jsonld","type":"Annotation","motivation":["commenting","tagging"],"id":"https://spokenweb.github.io/Ultimatumi1985/ken_decker_at_ultimatum_festival_1985_05_02/canvas/9/page1","body":[{"type":"TextualBody","value":"Ken further says: “STOP 4 GAS” was subsequently re-written in C and assembler for the Amiga computer, on a Canada Council grant, and exhibited at FAUST in Toulouse, France and at  PIXIM 1988 at la Villette, Paris, and at  La Cité des arts et des nouvelles technologies de Montréal, curated by Hervé Fischer.”","format":"text/plain","motivation":"commenting"},{"type":"TextualBody","value":"Event Description","format":"text/plain","purpose":"tagging","motivation":"tagging"}],"target":"https://spokenweb.github.io/Ultimatumi1985/ken_decker_at_ultimatum_festival_1985_05_02/canvas/9#t=79,79"},{"@context":"http://www.w3.org/ns/anno.jsonld","type":"Annotation","motivation":["commenting","tagging"],"id":"https://spokenweb.github.io/Ultimatumi1985/ken_decker_at_ultimatum_festival_1985_05_02/canvas/9/page1","body":[{"type":"TextualBody","value":"Ken Decker returned to read the story \"Cleaning The Tools\" at the Ultimatum II festival in September 1987.","format":"text/plain","motivation":"commenting"},{"type":"TextualBody","value":"Personal Anecdote","format":"text/plain","purpose":"tagging","motivation":"tagging"}],"target":"https://spokenweb.github.io/Ultimatumi1985/ken_decker_at_ultimatum_festival_1985_05_02/canvas/9#t=113,113"},{"@context":"http://www.w3.org/ns/anno.jsonld","type":"Annotation","motivation":["commenting","tagging"],"id":"https://spokenweb.github.io/Ultimatumi1985/ken_decker_at_ultimatum_festival_1985_05_02/canvas/9/page1","body":[{"type":"TextualBody","value":"In 1983 Ken Decker published a book of fictional texts called “Backyard Gene Pool” .","format":"text/plain","motivation":"commenting"},{"type":"TextualBody","value":"Biographical Context","format":"text/plain","purpose":"tagging","motivation":"tagging"}],"target":"https://spokenweb.github.io/Ultimatumi1985/ken_decker_at_ultimatum_festival_1985_05_02/canvas/9#t=145,145"}]}],"items":[{"id":"https://spokenweb.github.io/Ultimatumi1985/ken_decker_at_ultimatum_festival_1985_05_02-canvas9/paintings","type":"AnnotationPage","items":[{"id":"https://spokenweb.github.io/Ultimatumi1985/ken_decker_at_ultimatum_festival_1985_05_02-canvas9/paintings","type":"Annotation","motivation":"painting","body":{"id":"https://youtu.be/INWHodHwp0A","type":"Sound","format":"unknown","duration":959},"target":"https://spokenweb.github.io/Ultimatumi1985/ken_decker_at_ultimatum_festival_1985_05_02/canvas/9"}]}]}]}