{"@context":"http://iiif.io/api/presentation/3/context.json","id":"https://spokenweb.github.io/Ultimatumi1985/manifests/genevi-ve-letarte-at-ultimatum-festival-1985-05-01.json","type":"Manifest","label":{"en":["Geneviève Letarte at Ultimatum Festival 1985-05-01"]},"homepage":[{"id":"https://spokenweb.github.io/Ultimatumi1985","type":"Text","label":{"en":["Geneviève Letarte at Ultimatum Festival 1985-05-01"]},"format":"text/html"}],"metadata":[{"label":{"en":["Description"]},"value":{"en":["The following is a transcription of Genevieve Letarte’s performance at Ultimatum, Wednesday, May 1st, 1985. Letarte is an interdisciplinary artist from Montreal, Quebec, Canada, writing under various modes and capacities: she is the author of 4 novels, among them, Souvent la nuit tu te reveilles (2002) and Les Vertiges Molino (1996), a poet, singer and songwriter. Her most recent publication is a poetry collection entitled Mes Ailleurs (2020). Her performances often combine text, song and music, as does the following multimodal performance from Ultimatum ’85, which mixes sound, song and poetry. The Ultimatum LP features \"Petite Nuage et Betelgeueuse\" from this set, with electronic percussion by Bernard Poirier, music by Trafic D’Influences, synthesizer and trombone by Claude Saint-Jean, and word and voice by Genevieve Letarte."]}},{"label":{"en":["Language"]},"value":{"en":["English"]}}],"items":[{"id":"https://spokenweb.github.io/Ultimatumi1985/geneviève_letarte_at_ultimatum_festival_1985_05_01/canvas/3","type":"Canvas","duration":1322,"annotations":[{"@context":"http://iiif.io/api/presentation/3/context.json","id":"https://spokenweb.github.io/Ultimatumi1985/manifests/geneviève_letarte_at_ultimatum_festival_1985_05_01-canvas3-1","type":"AnnotationPage","label":{"en":["Default"]},"items":[{"@context":"http://www.w3.org/ns/anno.jsonld","type":"Annotation","motivation":["commenting","tagging"],"id":"https://spokenweb.github.io/Ultimatumi1985/geneviève_letarte_at_ultimatum_festival_1985_05_01/canvas/3/page1","body":[{"type":"TextualBody","value":"Static, crackling, drumbeat.","format":"text/plain","motivation":"commenting"},{"type":"TextualBody","value":"Recording","format":"text/plain","purpose":"tagging","motivation":"tagging"},{"type":"TextualBody","value":"Music","format":"text/plain","purpose":"tagging","motivation":"tagging"}],"target":"https://spokenweb.github.io/Ultimatumi1985/geneviève_letarte_at_ultimatum_festival_1985_05_01/canvas/3#t=0,13"},{"@context":"http://www.w3.org/ns/anno.jsonld","type":"Annotation","motivation":["commenting","tagging"],"id":"https://spokenweb.github.io/Ultimatumi1985/geneviève_letarte_at_ultimatum_festival_1985_05_01/canvas/3/page1","body":[{"type":"TextualBody","value":"Drumbeat continues, distorted electric guitar, electronic sounds, trombone.","format":"text/plain","motivation":"commenting"},{"type":"TextualBody","value":"Music","format":"text/plain","purpose":"tagging","motivation":"tagging"}],"target":"https://spokenweb.github.io/Ultimatumi1985/geneviève_letarte_at_ultimatum_festival_1985_05_01/canvas/3#t=13,96"},{"@context":"http://www.w3.org/ns/anno.jsonld","type":"Annotation","motivation":["commenting","tagging"],"id":"https://spokenweb.github.io/Ultimatumi1985/geneviève_letarte_at_ultimatum_festival_1985_05_01/canvas/3/page1","body":[{"type":"TextualBody","value":"Performs \"Petite Nuage et Betelgeueuse\", recites poetry and vocalizes atop distorted electric guitar, electronic sounds, and trombone.","format":"text/plain","motivation":"commenting"},{"type":"TextualBody","value":"Genevieve Letarte","format":"text/plain","purpose":"tagging","motivation":"tagging"},{"type":"TextualBody","value":"Music","format":"text/plain","purpose":"tagging","motivation":"tagging"}],"target":"https://spokenweb.github.io/Ultimatumi1985/geneviève_letarte_at_ultimatum_festival_1985_05_01/canvas/3#t=96,173"},{"@context":"http://www.w3.org/ns/anno.jsonld","type":"Annotation","motivation":["commenting","tagging"],"id":"ht