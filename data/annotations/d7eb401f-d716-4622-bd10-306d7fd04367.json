      "annotation": [
        {
          "type": "paragraph",
          "children": [
            {
              "text": "I say \"c'était Philippe Soupault\" (transl: \"it was Philippe Soupault\" - the Surrealist poet). Because the last line of the song/poem was a quote of his: \"Je plonge dans la joie, il y a encore tant de gens à assassiner\")"
            }
          ]
        }
